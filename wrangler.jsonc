{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howtofish",
  "compatibility_date": "2026-09-01",
  // Static site: Next.js `output: export` emits ./out, served directly as assets.
  // worker.mjs 只做一件事：www → apex 301，其余落到 ASSETS
  "main": "worker.mjs",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true, // 所有请求先过 worker（做 www 301），静态资源由 worker 内 ASSETS.fetch 回落
    // Pretty URLs: /fish-list/ -> out/fish-list/index.html; unknown paths -> 404.html
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
