# Security headers on every response.
# Note: no Content-Security-Policy - the Adsterra ad scripts load from rotating
# third-party domains that a strict CSP would break, so we keep the other
# high-value headers and skip CSP (common trade-off for ad-monetized sites).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: browsing-topics=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Immutable, content-hashed build assets: cache hard.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Optimized media: cache a month.
/game/*
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=604800
/icon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
